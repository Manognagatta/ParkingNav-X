__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# The active system's SQLite database is created fresh on first use
# (see digital_twin/db.py) and never committed -- it's local dev/test
# state, not source.
*.db
*.sqlite
*.sqlite3

# Simulation run output — regenerated by every test/run.
runs/*
!runs/.gitkeep
experiments/runs/*
!experiments/runs/.gitkeep

# Editor/OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local virtualenvs, if anyone creates one in-repo.
.venv/
venv/
.claude/
