__pycache__/
*.pyc
.pytest_cache/
.hypothesis/

# The active system's SQLite database is created fresh on first use
# (see digital_twin/db.py) and never committed -- it's local dev/test
# state, not source.
*.db
*.sqlite
*.sqlite3

# Simulation run output — raw logs ignored; only summary files tracked for vitap runs.
runs/*
!runs/.gitkeep
!runs/vitap-*/
runs/vitap-*/**/*
!runs/vitap-*/**/
!runs/vitap-*/**/metrics.json
!runs/vitap-*/**/manifest.json
!runs/vitap-*/**/summary.csv
experiments/runs/*
!experiments/runs/.gitkeep

# Editor/OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local virtualenvs, if anyone creates one in-repo.
.venv/
venv/
.claude/
data/observations/*.csv
!data/observations/template.csv
data/member2_synthetic/
