[run]
source = digital_twin
omit =
    */simulation/cli.py
    */simulation/verify_campus_config.py
    */simulation/verify_state_manager.py
    */simulation/campus_config.py
    */simulation/demo_strategies.py
    */simulation/state_manager.py
    */validation/validate_observations.py
    */digital_twin/gps_survey_import.py
    */digital_twin/scheduler.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    \.\.\.
